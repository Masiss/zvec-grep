#include <cppjieba/DictTrie.hpp>

#include <atomic>
#include <chrono>
#include <exception>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <memory>
#include <mutex>
#include <stdexcept>
#include <string>
#include <thread>
#include <vector>

namespace fs = std::filesystem;

namespace {

void Check(bool condition, const std::string& message) {
  if (!condition) throw std::runtime_error(message);
}

void WriteDictionary(const fs::path& path, const std::string& contents) {
  std::ofstream output(path, std::ios::binary);
  if (!output) throw std::runtime_error("cannot create dictionary fixture");
  output << contents;
  if (!output) throw std::runtime_error("cannot write dictionary fixture");
}

}  // namespace

int main() {
  const auto nonce = std::chrono::steady_clock::now().time_since_epoch().count();
  const fs::path root = fs::current_path() /
      ("cppjieba-cache-lifecycle-overlay-" + std::to_string(nonce));
  try {
    fs::create_directories(root);
    const fs::path first_path = root / "dictionary-a.txt";
    const fs::path second_path = root / "dictionary-b.txt";
    const fs::path shared_path = root / "dictionary-shared.txt";
    WriteDictionary(first_path, "alpha 100 n\nshared 50 n\n");
    WriteDictionary(second_path, "beta 100 n\nshared 50 n\n");
    WriteDictionary(shared_path, "shared 100 n\n");

    const size_t initial_builds = cppjieba::DictTrie::CacheBuildCountForTesting();
    std::mutex failure_mutex;
    std::vector<std::string> failures;
    std::vector<std::unique_ptr<cppjieba::DictTrie> > shared_analyzers;
    std::mutex analyzers_mutex;
    std::atomic<bool> start{false};
    std::vector<std::thread> openers;
    for (size_t i = 0; i < 4; ++i) {
      openers.emplace_back([&] {
        while (!start.load(std::memory_order_acquire)) std::this_thread::yield();
        try {
          std::unique_ptr<cppjieba::DictTrie> analyzer(
              new cppjieba::DictTrie(shared_path.string()));
          Check(analyzer->Find("shared"), "same-key analyzer lost its dictionary term");
          std::lock_guard<std::mutex> lock(analyzers_mutex);
          shared_analyzers.push_back(std::move(analyzer));
        } catch (const std::exception& error) {
          std::lock_guard<std::mutex> lock(failure_mutex);
          failures.push_back(error.what());
        }
      });
    }
    start.store(true, std::memory_order_release);
    for (auto& opener : openers) opener.join();
    Check(failures.empty(), "concurrent same-key initialization failed");
    Check(cppjieba::DictTrie::CacheBuildCountForTesting() == initial_builds + 1,
          "same-key concurrent opens parsed the dictionary more than once");
    Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
          "same-key opens did not share one live dictionary-cache entry");
    shared_analyzers.clear();
    Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
          "the bounded most-recent dictionary entry was not retained");
    const size_t before_same_version_reopen = cppjieba::DictTrie::CacheBuildCountForTesting();
    {
      cppjieba::DictTrie reopened(shared_path.string());
      Check(reopened.Find("shared"), "same-version reopen lost its dictionary term");
    }
    Check(cppjieba::DictTrie::CacheBuildCountForTesting() == before_same_version_reopen,
          "most-recent same-version reopen reparsed the dictionary");
    Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
          "same-version reopen changed the retained cache generation count");

    {
      std::unique_ptr<cppjieba::DictTrie> first(
          new cppjieba::DictTrie(first_path.string()));
      Check(first->Find("alpha") && !first->Find("beta"),
            "first dictionary contents are incorrect");
      std::unique_ptr<cppjieba::DictTrie> second(
          new cppjieba::DictTrie(second_path.string()));
      Check(second->Find("beta") && !second->Find("alpha"),
            "second dictionary contents are incorrect or aliased");
      Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 2,
            "active old and current dictionary generations were not both retained");
      first.reset();
      Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
            "old dictionary generation survived its final live analyzer");
    }
    Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
          "cache retained more than the most-recent generation after release");

    const size_t before_reopen = cppjieba::DictTrie::CacheBuildCountForTesting();
    {
      cppjieba::DictTrie reopened(first_path.string());
      Check(reopened.Find("alpha") && !reopened.Find("beta"),
            "reopening an older dictionary version returned stale terms");
    }
    Check(cppjieba::DictTrie::CacheBuildCountForTesting() == before_reopen + 1,
          "expired older version did not rebuild its own cache entry");
    Check(cppjieba::DictTrie::CacheLiveEntryCountForTesting() == 1,
          "reopening an older version left multiple unleased cache entries");

    std::error_code cleanup_error;
    fs::remove_all(root, cleanup_error);
    Check(!cleanup_error, "could not remove the test-owned temporary directory");
    std::cout << "cppjieba bounded cache lifecycle passed\n";
    return 0;
  } catch (const std::exception& error) {
    std::cerr << "cppjieba bounded cache lifecycle failed: " << error.what() << '\n';
    return 1;
  }
}
