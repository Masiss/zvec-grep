+  struct DictCacheSlot {
+    std::weak_ptr<const DictCacheEntry> entry;
+    std::condition_variable ready;
+    bool loading = false;
+    std::exception_ptr error;
+  };
+
+  struct DictCacheState {
+    std::mutex mutex;
+    std::unordered_map<std::string, std::shared_ptr<DictCacheSlot> > slots;
+    std::string retained_path;
+    std::shared_ptr<const DictCacheEntry> retained_entry;
+#ifdef CPPJIEBA_CACHE_LIFECYCLE_TESTING
+    size_t build_count{0};
+#endif
+  };
+
+  static DictCacheState& GetDictCacheState() {
+    static DictCacheState state;
+    return state;
+  }
+
+  static std::shared_ptr<const DictCacheEntry> GetDictCache(const std::string& filePath) {
+    DictCacheState& state = GetDictCacheState();
+    std::shared_ptr<DictCacheSlot> slot;
+    std::unique_lock<std::mutex> lock(state.mutex);
+    for (std::unordered_map<std::string, std::shared_ptr<DictCacheSlot> >::iterator it =
+             state.slots.begin(); it != state.slots.end();) {
+      if (it->first != state.retained_path && !it->second->loading &&
+          it->second->entry.expired()) {
+        it = state.slots.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    std::shared_ptr<DictCacheSlot>& slot_ref = state.slots[filePath];
+    if (!slot_ref) slot_ref.reset(new DictCacheSlot());
+    slot = slot_ref;
+
+    for (;;) {
+      if (state.retained_path == filePath && state.retained_entry) {
+        return state.retained_entry;
+      }
+      std::shared_ptr<const DictCacheEntry> cached = slot->entry.lock();
+      if (cached) {
+        state.retained_path = filePath;
+        state.retained_entry = cached;
+        return cached;
+      }
+      if (!slot->loading) {
+        slot->loading = true;
+        slot->error = std::exception_ptr();
+        break;
+      }
+      slot->ready.wait(lock, [&slot] { return !slot->loading; });
+      if (slot->error) {
+        const std::exception_ptr error = slot->error;
+        lock.unlock();
+        std::rethrow_exception(error);
+      }
+    }
+
+    lock.unlock();
+    std::shared_ptr<DictCacheEntry> built;
+    std::string retained_path;
+    try {
+      built.reset(new DictCacheEntry(BuildDictCacheEntry(filePath)));
+      retained_path = filePath;
+    } catch (...) {
+      lock.lock();
+      slot->error = std::current_exception();
+      slot->loading = false;
+      slot->ready.notify_all();
+      throw;
+    }
+
+    lock.lock();
+    slot->entry = built;
+    slot->loading = false;
+    slot->error = std::exception_ptr();
+    state.retained_path.swap(retained_path);
+    state.retained_entry = built;
+#ifdef CPPJIEBA_CACHE_LIFECYCLE_TESTING
+    ++state.build_count;
+#endif
+    slot->ready.notify_all();
+    return built;
