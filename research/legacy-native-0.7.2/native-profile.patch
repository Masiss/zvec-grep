+  s = ctx_.db_->Write(ctx_.write_opts_, &batch);
+  if (!s.ok()) {
+    LOG_ERROR("insert_batch Write failed reason[%s]", s.ToString().c_str());
+    return Status::InternalError();
+  }
+  update_max_id(batch_max_id);
