+# Number of parallel jobs for Arrow's nested ExternalProject build.
+#
+# Arrow's translation units are the heaviest in the tree (compute/parquet/acero),
+# so this nested build is deliberately a separate knob from the outer build's -j.
+# Inheriting NPROC can oversubscribe memory on small hosts, while pinning it too
+# low turns Arrow into the critical path and stalls the (much wider) outer build.
+# Default: half the processors, clamped to [2, 8]. Override without editing this
+# file via -DZVEC_ARROW_JOBS=<n> at configure time.
+set(ZVEC_ARROW_JOBS "" CACHE STRING
+    "Parallel jobs for the nested Arrow build (empty = auto)")
+if(NOT ZVEC_ARROW_JOBS)
+    math(EXPR ZVEC_ARROW_JOBS "${NPROC} / 2")
+    if(ZVEC_ARROW_JOBS LESS 2)
+        set(ZVEC_ARROW_JOBS 2)
+    elseif(ZVEC_ARROW_JOBS GREATER 8)
+        set(ZVEC_ARROW_JOBS 8)
+    endif()
+endif()
+message(STATUS "ZVEC_ARROW_JOBS = ${ZVEC_ARROW_JOBS}")
