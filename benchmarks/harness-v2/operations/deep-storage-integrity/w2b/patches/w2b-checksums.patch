diff --git a/src/core/framework/index_mapping.cc b/src/core/framework/index_mapping.cc
index b5c793d..35051bd 100644
--- a/src/core/framework/index_mapping.cc
+++ b/src/core/framework/index_mapping.cc
@@ -268,6 +268,67 @@ void IndexMapping::refresh(uint64_t check_point) {
     auto segment_start = reinterpret_cast<IndexFormat::SegmentMeta *>(
         reinterpret_cast<uint8_t *>(header) +
         (header->meta_footer_offset - footer->segments_meta_size));
+
+    // Only the active header can still receive writes. Previous headers are
+    // sealed; their segment CRCs and content CRC were computed when they were
+    // current. Recomputing those from a meta-only mapping would be unsafe.
+    if (header == header_) {
+      bool content_ok = true;
+      const uint8_t *content = nullptr;
+      size_t content_start = current_header_start_offset_ + header->content_offset;
+      if (footer->content_size > 0 &&
+          (content_start > file_.size() ||
+           footer->content_size > file_.size() - content_start)) {
+        content_ok = false;
+      }
+      if (content_ok && footer->content_size > 0) {
+        int opts = ailego::File::MMAP_SHARED;
+        if (huge_page_) {
+          opts |= ailego::File::MMAP_HUGE_PAGE;
+        }
+        content = reinterpret_cast<const uint8_t *>(ailego::File::MemoryMap(
+            file_.native_handle(),
+            content_start, footer->content_size, opts));
+        if (content == nullptr) {
+          content_ok = false;
+        }
+      }
+      if (content_ok) {
+        for (size_t i = 0; i < footer->segment_count; ++i) {
+          auto *segment = segment_start + i;
+          if (segment->data_index > footer->content_size ||
+              segment->data_size >
+                  footer->content_size - segment->data_index) {
+            content_ok = false;
+            break;
+          }
+          segment->data_crc =
+              segment->data_size == 0
+                  ? 0
+                  : ailego::Crc32c::Hash(content + segment->data_index,
+                                          segment->data_size, 0);
+        }
+      }
+      if (content_ok) {
+        footer->content_crc =
+            footer->content_size == 0
+                ? 0
+                : ailego::Crc32c::Hash(content, footer->content_size, 0);
+        header->reserved3_[0] = IndexFormat::CHECKSUM_CAPABILITY_V1;
+      } else {
+        // Never publish a partial seal as fully checksummed.
+        footer->content_crc = 0;
+        header->reserved3_[0] = 0;
+        checksum_valid_ = false;
+        LOG_ERROR("Failed to compute index checksums for %s", path_.c_str());
+      }
+      if (content != nullptr) {
+        ailego::File::MemoryUnmap(const_cast<uint8_t *>(content),
+                                  footer->content_size);
+      }
+      IndexFormat::UpdateMetaHeader(header);
+    }
+
     footer->segments_meta_crc =
         ailego::Crc32c::Hash(segment_start, footer->segments_meta_size, 0);
     IndexFormat::UpdateMetaFooter(footer, check_point);
