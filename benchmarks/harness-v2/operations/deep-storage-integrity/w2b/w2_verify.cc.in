// W2 PoC: read-only native integrity verifier for a sealed zvec generation.
// This file is standalone; it does not modify zvec core or the installed .so.

#include <fcntl.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <unistd.h>

#include <algorithm>
#include <cerrno>
#include <cstdint>
#include <cstring>
#include <filesystem>
#include <memory>
#include <sstream>
#include <string>
#include <vector>

#include <rocksdb/db.h>
#include <rocksdb/options.h>
#include <zvec/ailego/hash/crc32c.h>
#include <zvec/core/framework/index_unpacker.h>

namespace fs = std::filesystem;

namespace {

std::string json_escape(const std::string &value) {
  std::ostringstream out;
  for (unsigned char c : value) {
    switch (c) {
      case '"': out << "\\\""; break;
      case '\\': out << "\\\\"; break;
      case '\n': out << "\\n"; break;
      case '\r': out << "\\r"; break;
      case '\t': out << "\\t"; break;
      default:
        if (c < 0x20) {
          char buf[7];
          std::snprintf(buf, sizeof(buf), "\\u%04x", c);
          out << buf;
        } else {
          out << c;
        }
    }
  }
  return out.str();
}

struct ProximaResult {
  std::string path;
  bool parsed = false;
  bool checksum_ok = false;
  bool per_segment_ok = true;
  bool capability_ok = false;
  bool complete = false;
  bool size_ok = true;
  uint64_t capability = 0;
  std::string error;
  uint32_t content_crc = 0;
  uint64_t content_size = 0;
  uint64_t total_size = 0;
  size_t segments = 0;
  size_t segments_with_crc = 0;
  size_t segments_without_crc = 0;
  uint64_t unprotected_bytes = 0;
  size_t segment_crc_mismatches = 0;
};

class MappedFile {
 public:
  explicit MappedFile(const std::string &path) : path_(path) {
    fd_ = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
    if (fd_ < 0) {
      error_ = std::strerror(errno);
      return;
    }
    struct stat st {};
    if (::fstat(fd_, &st) != 0) {
      error_ = std::strerror(errno);
      return;
    }
    size_ = static_cast<size_t>(st.st_size);
    if (size_ == 0) {
      error_ = "empty file";
      return;
    }
    data_ = ::mmap(nullptr, size_, PROT_READ, MAP_PRIVATE, fd_, 0);
    if (data_ == MAP_FAILED) {
      data_ = nullptr;
      error_ = std::strerror(errno);
    }
  }
  ~MappedFile() {
    if (data_ != nullptr) ::munmap(data_, size_);
    if (fd_ >= 0) ::close(fd_);
  }
  MappedFile(const MappedFile &) = delete;
  MappedFile &operator=(const MappedFile &) = delete;

  const uint8_t *data() const { return static_cast<const uint8_t *>(data_); }
  size_t size() const { return size_; }
  const std::string &error() const { return error_; }
  bool ok() const { return data_ != nullptr; }

 private:
  std::string path_;
  int fd_ = -1;
  void *data_ = nullptr;
  size_t size_ = 0;
  std::string error_;
};

bool verify_proxima(const fs::path &path, ProximaResult &result) {
  result.path = path.string();
  MappedFile file(path.string());
  if (!file.ok()) {
    result.error = file.error();
    return false;
  }
  const uint8_t *base = file.data();
  const size_t total = file.size();
  auto read_data = [&](size_t offset, const void **data, size_t len) -> size_t {
    if (offset > total || len > total - offset) return 0;
    *data = base + offset;
    return len;
  };

  zvec::core::IndexUnpacker unpacker;
  result.parsed = unpacker.unpack(read_data, total, true);
  if (!result.parsed) {
    result.error = "IndexUnpacker rejected header/footer/segment table/content CRC";
    return false;
  }
  result.checksum_ok = true;
  result.capability = unpacker.header().reserved3_[0];
  result.capability_ok = result.capability == 0x5A564543484B5331ULL;
  result.size_ok = total >= unpacker.footer().total_size;
  if (!result.size_ok) {
    result.error = "file is smaller than footer total_size";
    return false;
  }
  result.content_crc = unpacker.footer().content_crc;
  result.content_size = unpacker.footer().content_size;
  result.total_size = unpacker.footer().total_size;
  result.segments = unpacker.segments().size();
  for (const auto &[id, meta] : unpacker.segments()) {
    (void)id;
    if (meta.data_crc() == 0) {
      ++result.segments_without_crc;
      result.unprotected_bytes += meta.data_size();
      continue;
    }
    ++result.segments_with_crc;
    const uint8_t *data = nullptr;
    const size_t got = read_data(meta.data_offset(), (const void **)&data,
                                 meta.data_size());
    if (got != meta.data_size() ||
        zvec::ailego::Crc32c::Hash(data, got, 0u) != meta.data_crc()) {
      ++result.segment_crc_mismatches;
      result.per_segment_ok = false;
    }
  }
  if (!result.per_segment_ok) {
    result.error = "segment CRC mismatch";
  }
  result.complete = result.capability_ok &&
                    (result.content_size == 0 || result.content_crc != 0) &&
                    result.segments_without_crc == 0;
  return result.per_segment_ok;
}

struct RocksResult {
  std::string path;
  bool ok = false;
  std::string error;
};

bool verify_rocksdb(const fs::path &path, RocksResult &result) {
  result.path = path.string();
  rocksdb::Options options;
  options.create_if_missing = false;
  options.paranoid_checks = true;
  std::vector<std::string> names;
  auto status = rocksdb::DB::ListColumnFamilies(options, path.string(), &names);
  if (!status.ok()) {
    result.error = "ListColumnFamilies: " + status.ToString();
    return false;
  }
  std::vector<rocksdb::ColumnFamilyDescriptor> descriptors;
  descriptors.reserve(names.size());
  for (const auto &name : names) {
    descriptors.emplace_back(name, rocksdb::ColumnFamilyOptions(options));
  }
  if (descriptors.empty()) {
    descriptors.emplace_back(rocksdb::kDefaultColumnFamilyName,
                             rocksdb::ColumnFamilyOptions(options));
  }
  std::vector<rocksdb::ColumnFamilyHandle *> handles;
  rocksdb::DB *db = nullptr;
  status = rocksdb::DB::OpenForReadOnly(options, path.string(), descriptors,
                                        &handles, &db);
  if (!status.ok()) {
    result.error = "OpenForReadOnly: " + status.ToString();
    return false;
  }
  rocksdb::ReadOptions read_options;
  read_options.verify_checksums = true;
  status = db->VerifyChecksum(read_options);
  for (auto *handle : handles) db->DestroyColumnFamilyHandle(handle);
  delete db;
  if (!status.ok()) {
    result.error = "VerifyChecksum: " + status.ToString();
    return false;
  }
  result.ok = true;
  return true;
}

bool is_rocksdb_dir(const fs::path &path) {
  std::error_code ec;
  if (!fs::is_directory(path, ec)) return false;
  if (!fs::exists(path / "CURRENT", ec)) return false;
  for (const auto &entry : fs::directory_iterator(path, ec)) {
    if (!entry.is_regular_file()) continue;
    const auto name = entry.path().filename().string();
    if (name.rfind("MANIFEST-", 0) == 0) return true;
  }
  return false;
}

std::string verify_generation(const std::string &root_path) {
  std::vector<ProximaResult> proxima;
  std::vector<RocksResult> rocks;
  std::vector<std::string> errors;
  size_t proxima_files = 0;
  size_t rocksdb_dirs = 0;
  size_t ignored_files = 0;

  std::error_code ec;
  fs::path root(root_path);
  if (!fs::exists(root, ec) || !fs::is_directory(root, ec)) {
    return std::string("{\"pass\":false,\"fatal\":\"not a directory\",\"root\":\"") +
           json_escape(root_path) + "\"}";
  }

  std::vector<fs::path> dirs;
  for (auto it = fs::recursive_directory_iterator(
           root, fs::directory_options::skip_permission_denied, ec);
       it != fs::recursive_directory_iterator(); it.increment(ec)) {
    if (ec) {
      errors.push_back("walk: " + ec.message());
      ec.clear();
      continue;
    }
    if (!it->is_directory()) continue;
    if (is_rocksdb_dir(it->path())) dirs.push_back(it->path());
  }
  std::sort(dirs.begin(), dirs.end());
  for (const auto &dir : dirs) {
    RocksResult result;
    ++rocksdb_dirs;
    if (!verify_rocksdb(dir, result)) errors.push_back(result.error);
    rocks.push_back(std::move(result));
  }

  for (auto it = fs::recursive_directory_iterator(
           root, fs::directory_options::skip_permission_denied, ec);
       it != fs::recursive_directory_iterator(); it.increment(ec)) {
    if (ec) {
      errors.push_back("walk: " + ec.message());
      ec.clear();
      continue;
    }
    if (!it->is_regular_file()) continue;
    if (it->path().extension() == ".proxima") {
      ProximaResult result;
      ++proxima_files;
      if (!verify_proxima(it->path(), result)) errors.push_back(result.error);
      proxima.push_back(std::move(result));
    } else {
      ++ignored_files;
    }
  }

  bool pass = errors.empty();
  size_t unprotected_bytes = 0;
  size_t zero_crc_segments = 0;
  size_t content_crc_zero = 0;
  size_t incomplete_proxima = 0;
  for (const auto &p : proxima) {
    unprotected_bytes += p.unprotected_bytes;
    zero_crc_segments += p.segments_without_crc;
    if (p.content_crc == 0) ++content_crc_zero;
    if (!p.complete) ++incomplete_proxima;
  }
  const bool complete = incomplete_proxima == 0;

  std::ostringstream out;
  out << "{\"pass\":" << (pass ? "true" : "false")
      << ",\"root\":\"" << json_escape(root_path) << "\""
      << ",\"proxima_files\":" << proxima_files
      << ",\"rocksdb_dirs\":" << rocksdb_dirs
      << ",\"ignored_files\":" << ignored_files
      << ",\"unprotected_bytes\":" << unprotected_bytes
      << ",\"zero_crc_segments\":" << zero_crc_segments
      << ",\"content_crc_zero_files\":" << content_crc_zero
      << ",\"incomplete_proxima_files\":" << incomplete_proxima
      << ",\"coverage_complete\":" << (complete ? "true" : "false")
      << ",\"legacy\":" << (incomplete_proxima > 0 ? "true" : "false")
      << ",\"status\":\"" << (pass ? (complete ? "pass_complete" : "pass_incomplete") : "corrupt") << "\""
      << ",\"errors\":[";
  for (size_t i = 0; i < errors.size(); ++i) {
    if (i) out << ',';
    out << '"' << json_escape(errors[i]) << '"';
  }
  out << "],\"proxima\":[";
  for (size_t i = 0; i < proxima.size(); ++i) {
    const auto &p = proxima[i];
    if (i) out << ',';
    out << "{\"path\":\"" << json_escape(p.path) << "\""
        << ",\"parsed\":" << (p.parsed ? "true" : "false")
        << ",\"checksum_ok\":" << (p.checksum_ok ? "true" : "false")
        << ",\"per_segment_ok\":" << (p.per_segment_ok ? "true" : "false")
        << ",\"capability\":" << p.capability
        << ",\"capability_ok\":" << (p.capability_ok ? "true" : "false")
        << ",\"complete\":" << (p.complete ? "true" : "false")
        << ",\"size_ok\":" << (p.size_ok ? "true" : "false")
        << ",\"content_crc\":" << p.content_crc
        << ",\"content_size\":" << p.content_size
        << ",\"total_size\":" << p.total_size
        << ",\"segments\":" << p.segments
        << ",\"segments_with_crc\":" << p.segments_with_crc
        << ",\"segments_without_crc\":" << p.segments_without_crc
        << ",\"unprotected_bytes\":" << p.unprotected_bytes
        << ",\"segment_crc_mismatches\":" << p.segment_crc_mismatches
        << ",\"error\":\"" << json_escape(p.error) << "\"}";
  }
  out << "],\"rocksdb\":[";
  for (size_t i = 0; i < rocks.size(); ++i) {
    const auto &r = rocks[i];
    if (i) out << ',';
    out << "{\"path\":\"" << json_escape(r.path) << "\""
        << ",\"ok\":" << (r.ok ? "true" : "false")
        << ",\"error\":\"" << json_escape(r.error) << "\"}";
  }
  out << "]}";
  return out.str();
}

}  // namespace

extern "C" {

const char *zvec_w2_verify_generation(const char *root) {
  if (root == nullptr) return nullptr;
  const std::string result = verify_generation(root);
  char *copy = static_cast<char *>(std::malloc(result.size() + 1));
  if (copy == nullptr) return nullptr;
  std::memcpy(copy, result.c_str(), result.size() + 1);
  return copy;
}

void zvec_w2_free_string(const char *value) {
  std::free(const_cast<char *>(value));
}

}  // extern "C"

#ifdef W2_STANDALONE
#include <cstdio>
int main(int argc, char **argv) {
  if (argc != 2) {
    std::fprintf(stderr, "usage: %s <generation-root>\n", argv[0]);
    return 2;
  }
  const char *report = zvec_w2_verify_generation(argv[1]);
  if (report == nullptr) return 2;
  std::printf("%s\n", report);
  const bool corrupt = std::strstr(report, "\"pass\":false") != nullptr;
  const bool complete = std::strstr(report, "\"coverage_complete\":true") != nullptr;
  zvec_w2_free_string(report);
  if (corrupt) return 1;
  return complete ? 0 : 2;
}
#endif
