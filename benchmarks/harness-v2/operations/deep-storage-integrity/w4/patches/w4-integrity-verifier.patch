+// =============================================================================
+// Read-only deep integrity verification
+// =============================================================================
+
+/**
+ * @brief Verification return codes.
+ */
+typedef enum {
+  ZVEC_INTEGRITY_PASS = 0,
+  ZVEC_INTEGRITY_CORRUPT = 1,
+  ZVEC_INTEGRITY_INCOMPLETE = 2,
+  ZVEC_INTEGRITY_INVALID_ARG = 3
+} zvec_integrity_code_t;
+
+/** Verify RocksDB column families (SST, MANIFEST, metadata). */
+#define ZVEC_INTEGRITY_ROCKSDB 0x1u
+/** Verify Proxima header/footer/segment-table structure. */
+#define ZVEC_INTEGRITY_PROXIMA_STRUCTURE 0x2u
+/** Verify Proxima content and per-segment CRCs. */
+#define ZVEC_INTEGRITY_PROXIMA_CONTENT 0x4u
+/** Return INCOMPLETE when requested coverage is not complete. */
+#define ZVEC_INTEGRITY_REQUIRE_COMPLETE 0x8u
+/** Internal: verify a staged generation without probing storage.lock. */
+#define ZVEC_INTEGRITY_SKIP_STABILITY 0x10u
+/** Light seal check: required layout plus Proxima structure only. */
+#define ZVEC_INTEGRITY_LIGHT 0x20u
+/** Verifier C ABI version. */
+#define ZVEC_INTEGRITY_ABI_VERSION 1u
+
+/**
+ * @brief Opaque integrity report.
+ *
+ * Released with zvec_integrity_report_free(). The JSON pointer returned by
+ * zvec_integrity_report_json() stays valid until then.
+ */
+typedef struct zvec_integrity_report zvec_integrity_report;
+
+/**
+ * @brief Verify a sealed collection read-only.
+ *
+ * Flags with value 0 select RocksDB, Proxima structure and Proxima content.
+ * The verifier takes a shared advisory lock on the owning storage generation
+ * when a storage.lock file is present and refuses a generation held by an
+ * active writer. It never creates, repairs or rewrites storage.
+ *
+ * @param collection_path Collection or generation storage directory.
+ * @param flags Bitwise combination of ZVEC_INTEGRITY_* flags.
+ * @param out Receives an owned report on PASS/CORRUPT/INCOMPLETE.
+ * @return ZVEC_INTEGRITY_PASS, ZVEC_INTEGRITY_CORRUPT,
+ *         ZVEC_INTEGRITY_INCOMPLETE or ZVEC_INTEGRITY_INVALID_ARG.
+ */
+ZVEC_EXPORT int ZVEC_CALL zvec_collection_verify_integrity(
+    const char *collection_path, unsigned int flags,
+    zvec_integrity_report **out);
+
+/** @brief Verifier C ABI version implemented by this library. */
+ZVEC_EXPORT unsigned int ZVEC_CALL zvec_integrity_abi_version(void);
+
+/** @brief 1 when no corruption was detected, otherwise 0. */
+ZVEC_EXPORT int ZVEC_CALL
+zvec_integrity_report_ok(const zvec_integrity_report *report);
+
+/** @brief 1 when every present artifact category was verified, else 0. */
+ZVEC_EXPORT int ZVEC_CALL
+zvec_integrity_report_complete(const zvec_integrity_report *report);
+
+/** @brief Borrowed JSON report; valid until the report is freed. */
+ZVEC_EXPORT const char *ZVEC_CALL
+zvec_integrity_report_json(const zvec_integrity_report *report);
+
+/** @brief Release a report returned by the verifier. */
+ZVEC_EXPORT void ZVEC_CALL
+zvec_integrity_report_free(zvec_integrity_report *report);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif
