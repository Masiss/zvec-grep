@@ -268,6 +268,105 @@ void IndexMapping::refresh(uint64_t check_point) {
     auto segment_start = reinterpret_cast<IndexFormat::SegmentMeta *>(
         reinterpret_cast<uint8_t *>(header) +
         (header->meta_footer_offset - footer->segments_meta_size));
+
+    // Recompute checksums with this header's own content base. The active
+    // header is rewritten on every refresh. Sealed headers are only revisited
+    // when they lack a capability marker or still contain a zero segment CRC,
+    // which closes the late-segment CRC gap without rehashing every seal.
+    auto recompute_header_checksums = [&](
+                                          IndexFormat::MetaHeader *target_header,
+                                          uint64_t header_start_offset,
+                                          bool force) {
+      auto *target_footer = reinterpret_cast<IndexFormat::MetaFooter *>(
+          reinterpret_cast<uint8_t *>(target_header) +
+          target_header->meta_footer_offset);
+      auto *target_segments = reinterpret_cast<IndexFormat::SegmentMeta *>(
+          reinterpret_cast<uint8_t *>(target_header) +
+          (target_header->meta_footer_offset -
+           target_footer->segments_meta_size));
+
+      bool needs = force;
+      if (!needs && target_header->reserved3_[0] !=
+                        IndexFormat::CHECKSUM_CAPABILITY_V1) {
+        needs = true;
+      }
+      if (!needs && target_footer->content_size > 0 &&
+          target_footer->content_crc == 0) {
+        needs = true;
+      }
+      if (!needs) {
+        for (size_t i = 0; i < target_footer->segment_count; ++i) {
+          const auto *segment = target_segments + i;
+          if (segment->data_size > 0 && segment->data_crc == 0) {
+            needs = true;
+            break;
+          }
+        }
+      }
+      if (!needs) {
+        return;
+      }
+
+      bool content_ok = true;
+      const uint8_t *content = nullptr;
+      const size_t content_start =
+          header_start_offset + target_header->content_offset;
+      if (target_footer->content_size > 0 &&
+          (content_start > file_.size() ||
+           target_footer->content_size > file_.size() - content_start)) {
+        content_ok = false;
+      }
+      if (content_ok && target_footer->content_size > 0) {
+        int opts = ailego::File::MMAP_SHARED;
+        if (huge_page_) {
+          opts |= ailego::File::MMAP_HUGE_PAGE;
+        }
+        content = reinterpret_cast<const uint8_t *>(ailego::File::MemoryMap(
+            file_.native_handle(), content_start, target_footer->content_size,
+            opts));
+        if (content == nullptr) {
+          content_ok = false;
+        }
+      }
+      if (content_ok) {
+        for (size_t i = 0; i < target_footer->segment_count; ++i) {
+          auto *segment = target_segments + i;
+          if (segment->data_index > target_footer->content_size ||
+              segment->data_size >
+                  target_footer->content_size - segment->data_index) {
+            content_ok = false;
+            break;
+          }
+          segment->data_crc =
+              segment->data_size == 0
+                  ? 0
+                  : ailego::Crc32c::Hash(content + segment->data_index,
+                                          segment->data_size, 0);
+        }
+      }
+      if (content_ok) {
+        target_footer->content_crc =
+            target_footer->content_size == 0
+                ? 0
+                : ailego::Crc32c::Hash(content, target_footer->content_size, 0);
+        target_header->reserved3_[0] =
+            IndexFormat::CHECKSUM_CAPABILITY_V1;
+      } else {
+        // Never publish a partial seal as fully checksummed.
+        target_footer->content_crc = 0;
+        target_header->reserved3_[0] = 0;
+        checksum_valid_ = false;
+        LOG_ERROR("Failed to compute index checksums for %s", path_.c_str());
+      }
+      if (content != nullptr) {
+        ailego::File::MemoryUnmap(const_cast<uint8_t *>(content),
+                                  target_footer->content_size);
+      }
+      IndexFormat::UpdateMetaHeader(target_header);
+    };
+
+    recompute_header_checksums(header, item.first, header == header_);
+
     footer->segments_meta_crc =
         ailego::Crc32c::Hash(segment_start, footer->segments_meta_size, 0);
     IndexFormat::UpdateMetaFooter(footer, check_point);
