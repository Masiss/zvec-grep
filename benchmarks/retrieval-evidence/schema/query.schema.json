{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zvec-grep/e3-01/query.schema.json",
  "title": "E3-01 retrieval evidence query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "schema_version",
    "queries"
  ],
  "properties": {
    "dataset": {
      "const": "e3-01-v2"
    },
    "schema_version": {
      "const": 1
    },
    "queries": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "corpus",
        "corpus_revision",
        "category",
        "question",
        "intent",
        "answerable",
        "leakage",
        "evidence",
        "hard_negatives",
        "absence_checks",
        "solved_when",
        "annotation",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[0-9]{2}-[a-z0-9-]+$"
        },
        "corpus": {
          "enum": [
            "dapper",
            "newtonsoft",
            "antlr"
          ]
        },
        "corpus_revision": {
          "const": "e3-01-v2"
        },
        "category": {
          "enum": [
            "exact_symbol",
            "nl_implementation",
            "hardcoded_value",
            "configuration",
            "configuration_flow",
            "cross_file",
            "data_flow",
            "sql_database",
            "serialization",
            "linq",
            "data_structure",
            "docs_vs_impl",
            "multi_hop",
            "no_answer"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 12
        },
        "intent": {
          "type": "string",
          "minLength": 8
        },
        "answerable": {
          "type": "boolean"
        },
        "leakage": {
          "enum": [
            "none",
            "identifier"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "hard_negatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "absence_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absence"
          }
        },
        "solved_when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_groups"
          ],
          "properties": {
            "required_groups": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "min_primary_evidence": {
              "type": "integer",
              "minimum": 0
            },
            "max_false_positives": {
              "type": "integer",
              "minimum": 0
            },
            "required_anchor_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance",
            "confidence",
            "review"
          ],
          "properties": {
            "provenance": {
              "const": "source-first manual annotation; no zg results consulted"
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "review": {
              "type": "string",
              "minLength": 4
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answerable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "solved_when": {
                "properties": {
                  "required_anchor_ids": {
                    "minItems": 1
                  }
                },
                "required": [
                  "required_groups",
                  "min_primary_evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerable": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              },
              "hard_negatives": {
                "minItems": 1
              },
              "absence_checks": {
                "minItems": 1
              },
              "solved_when": {
                "properties": {
                  "required_anchor_ids": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "path",
        "start_line",
        "end_line",
        "symbol",
        "role",
        "rationale",
        "confidence",
        "content_sha256",
        "preview"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(dapper|newtonsoft|antlr)/.+\\.cs$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "primary",
            "supporting",
            "hard_negative"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preview": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[0-9]{2}-[a-z0-9-]+-[en][0-9]+$"
        }
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "scope",
        "expected_matches"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "pattern": "^(dapper|newtonsoft|antlr)/"
        },
        "expected_matches": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
